{
  "name": "@zhanghonghu13/dsh-mail-assistant",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "description": "AI-first Mail Assistant for DeepSeek Harness: a local and AI brief home, on-demand mail reader, search, attachments, persistent draft editor, multi-account settings, and agent tools to read, draft, reply, forward and send with approval.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghonghu13/dsh-mail-assistant.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mail",
    "email",
    "imap",
    "smtp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./remote": "./lib/remote.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build:client": "esbuild client-source.js --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=client.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
